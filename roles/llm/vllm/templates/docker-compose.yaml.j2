services:
  vllm:
    image: {{ vllm_image }}:{{ vllm_version }}
    environment:
      NVIDIA_VISIBLE_DEVICES: {{ vllm_gpu_devices_normalized | to_json }}
{% if vllm_ray_enabled and ('RAY_ADDRESS' not in vllm_extra_env) %}
      RAY_ADDRESS: {{ vllm_ray_address | to_json }}
{% endif %}
{% if vllm_ray_enabled and ('RAY_TMPDIR' not in vllm_extra_env) %}
      RAY_TMPDIR: {{ vllm_ray_tmpdir | to_json }}
{% endif %}
{% if vllm_ray_enabled and ('VLLM_HOST_IP' not in vllm_extra_env) %}
      VLLM_HOST_IP: {{ vllm_host_ip | to_json }}
{% endif %}
{% for env_name, env_value in vllm_extra_env.items() %}
{% if env_name != 'NVIDIA_VISIBLE_DEVICES' %}
      {{ env_name }}: {{ env_value | to_json }}
{% endif %}
{% endfor %}
{% if vllm_tensor_parallel_size == 'auto' %}
    command: []
{% else %}
    command: >-
{% if vllm_cli_command %}
      {{ vllm_cli_command }}
{% endif %}
      {{ vllm_model_name }}
      --served-model-name {{ vllm_served_model_name if vllm_served_model_name else vllm_model_name }}
      --host 0.0.0.0
{% if vllm_ray_enabled %}
      --distributed-executor-backend ray
{% if vllm_ray_extra_args %}
      {{ vllm_ray_extra_args }}
{% endif %}
{% endif %}
      --pipeline-parallel-size {{ vllm_pipeline_parallel_size }}
      --tensor-parallel-size {{ vllm_tensor_parallel_size }}
      --gpu-memory-utilization {{ vllm_gpu_memory_utilization }}
      --seed {{ vllm_seed }}
{% if vllm_watermark is not none %}
      --watermark {{ vllm_watermark }}
{% endif %}
{% if vllm_mamba_ssm_cache_dtype is not none %}
      --mamba-ssm-cache-dtype {{ vllm_mamba_ssm_cache_dtype }}
{% endif %}
{% if vllm_max_num_partial_prefills is not none %}
      --max-num-partial-prefills {{ vllm_max_num_partial_prefills }}
{% endif %}
{% if vllm_max_long_partial_prefills is not none %}
      --max-long-partial-prefills {{ vllm_max_long_partial_prefills }}
{% endif %}
{% if vllm_long_prefill_token_threshold is not none %}
      --long-prefill-token-threshold {{ vllm_long_prefill_token_threshold }}
{% endif %}
{% if vllm_load_format is not none %}
      --load-format {{ vllm_load_format }}
{% endif %}
{% if vllm_attention_backend is not none %}
      --attention-backend {{ vllm_attention_backend }}
{% endif %}
{% if vllm_kv_cache_dtype is not none %}
      --kv-cache-dtype {{ vllm_kv_cache_dtype }}
{% endif %}
{% if vllm_enable_prefix_caching %}
      --enable-prefix-caching
{% endif %}
{% if vllm_enable_auto_tool_choice %}
      --enable-auto-tool-choice
{% endif %}
{% if vllm_tool_call_parser is not none %}
      --tool-call-parser {{ vllm_tool_call_parser }}
{% endif %}
{% if vllm_trust_remote_code %}
      --trust-remote-code
{% endif %}
{% if vllm_reasoning_parser is not none %}
      --reasoning-parser {{ vllm_reasoning_parser }}
{% endif %}
{% if vllm_max_model_len is not none %}
      --max-model-len {{ vllm_max_model_len }}
{% endif %}
{% if vllm_max_num_seqs is not none %}
      --max-num-seqs {{ vllm_max_num_seqs }}
{% endif %}
{% if vllm_max_num_batched_tokens is not none %}
      --max-num-batched-tokens {{ vllm_max_num_batched_tokens }}
{% endif %}
{% if vllm_api_key %}
      --api-key {{ vllm_api_key }}
{% endif %}
{% if vllm_speculative_config %}
      --speculative-config {{ vllm_speculative_config | quote }}
{% endif %}
{% if vllm_override_generation_config is not none and vllm_override_generation_config | length > 0 %}
      --override-generation-config {{ vllm_override_generation_config | to_json | quote }}
{% endif %}
{% if vllm_extra_args %}
      {{ vllm_extra_args }}
{% endif %}
{% if vllm_extra_args_list %}
{% for arg in vllm_extra_args_list %}
      {{ arg }}
{% endfor %}
{% endif %}
{% endif %}
{% if vllm_tensor_parallel_size == 'auto' %}
    entrypoint:
      - /usr/local/bin/vllm-entrypoint.sh
    labels:
      vllm-entrypoint-checksum: {{ vllm_entrypoint_checksum | to_json }}
{% endif %}
    deploy:
      replicas: 1
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: {{ vllm_gpu_count }}
              capabilities: [gpu]
    restart: unless-stopped
{% if vllm_ipc_host %}
    ipc: host
{% endif %}
{% if vllm_ulimits %}
    ulimits:
{% for ulimit_name, ulimit_value in vllm_ulimits.items() %}
      {{ ulimit_name }}: {{ ulimit_value }}
{% endfor %}
{% endif %}
{% if vllm_ray_enabled and vllm_ray_network_mode is not none %}
    network_mode: {{ vllm_ray_network_mode }}
{% endif %}
    ports:
{% if not (vllm_ray_enabled and vllm_ray_network_mode == 'host') %}
      - {{ vllm_port }}:8000
{% endif %}
    env_file:
      - .env
    volumes:
{% if vllm_tensor_parallel_size == 'auto' %}
      - {{ vllm_remote_dir }}/vllm-entrypoint.sh:/usr/local/bin/vllm-entrypoint.sh:ro
{% endif %}
      - {{ vllm_host_huggingface_cache_dir }}:/root/.cache/huggingface
      - {{ vllm_host_vllm_cache_dir }}:/root/.cache/vllm
      - {{ vllm_host_triton_cache_dir }}:/root/.triton
      - {{ vllm_host_flashinfer_cache_dir }}:/root/.cache/flashinfer
{% if vllm_ray_enabled %}
      - {{ vllm_ray_host_tmp_dir }}:{{ vllm_ray_tmpdir }}
{% endif %}
    healthcheck:
      test:
        - CMD-SHELL
        - 'curl -fsS "http://localhost:8000/health" >/dev/null'
      interval: 15s
      timeout: 5s
      retries: 20
      start_period: 30s
    logging:
      options:
        max-file: "5"
        max-size: "20m"
