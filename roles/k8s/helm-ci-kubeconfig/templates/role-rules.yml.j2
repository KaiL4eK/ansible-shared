---
{% set core_resources = ['configmaps', 'secrets', 'services'] %}
{% if k8s_helm_ci_manage_serviceaccounts | bool %}
{% set core_resources = core_resources + ['serviceaccounts'] %}
{% endif %}
{% if k8s_helm_ci_manage_persistentvolumeclaims | bool %}
{% set core_resources = core_resources + ['persistentvolumeclaims'] %}
{% endif %}
- apiGroups: [""]
  resources: {{ core_resources | to_json }}
  verbs: [get, list, watch, create, update, patch, delete]
- apiGroups: [apps]
  resources: [deployments]
  verbs: [get, list, watch, create, update, patch, delete]
- apiGroups: [batch]
  resources: [jobs]
  verbs: [get, list, watch, create, update, patch, delete]
- apiGroups: [networking.k8s.io]
  resources: [ingresses]
  verbs: [get, list, watch, create, update, patch, delete]
- apiGroups: [""]
  resources: [pods]
  verbs: [get, list, watch]
- apiGroups: [apps]
  resources: [replicasets]
  verbs: [get, list, watch]
{% if k8s_helm_ci_manage_statefulsets | bool %}
- apiGroups: [apps]
  resources: [statefulsets]
  verbs: [get, list, watch, create, update, patch, delete]
{% endif %}
{% if k8s_helm_ci_manage_daemonsets | bool %}
- apiGroups: [apps]
  resources: [daemonsets]
  verbs: [get, list, watch, create, update, patch, delete]
{% endif %}
{% if k8s_helm_ci_manage_cronjobs | bool %}
- apiGroups: [batch]
  resources: [cronjobs]
  verbs: [get, list, watch, create, update, patch, delete]
{% endif %}
{% if k8s_helm_ci_manage_horizontalpodautoscalers | bool %}
- apiGroups: [autoscaling]
  resources: [horizontalpodautoscalers]
  verbs: [get, list, watch, create, update, patch, delete]
{% endif %}
{% if k8s_helm_ci_manage_poddisruptionbudgets | bool %}
- apiGroups: [policy]
  resources: [poddisruptionbudgets]
  verbs: [get, list, watch, create, update, patch, delete]
{% endif %}
{% if k8s_helm_ci_manage_networkpolicies | bool %}
- apiGroups: [networking.k8s.io]
  resources: [networkpolicies]
  verbs: [get, list, watch, create, update, patch, delete]
{% endif %}
