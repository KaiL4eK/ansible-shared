#!/bin/sh
set -eu

BACKUP_ROOT="${BACKUP_ROOT:-{{ backup_monitoring_backup_root }}}"
LOCK_DIR_NAME="${LOCK_DIR_NAME:-{{ backup_monitoring_lock_dir_name }}}"
LOCK_MAX_AGE_SECONDS="${LOCK_MAX_AGE_SECONDS:-{{ backup_monitoring_lock_max_age_seconds }}}"
LOCK_DIR="${BACKUP_ROOT}/${LOCK_DIR_NAME}"
RESTORE_DB_NAME="${RESTORE_DB_NAME:-}"
RESTORE_BACKUP_NAME="${RESTORE_BACKUP_NAME:-}"
RESTORE_WORK_DIR="/tmp/restore-$$"

log_info() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

run_psql() {
  PGPASSWORD="${SOURCE_DB_PASSWORD}" psql \
    -v ON_ERROR_STOP=1 \
    -h "${SOURCE_DB_HOST}" \
    -p "${SOURCE_DB_PORT}" \
    -U "${SOURCE_DB_USER}" \
    -d "${SOURCE_DB_NAME}" \
    "$@"
}

run_psql_on_db() {
  target_db="$1"
  shift

  PGPASSWORD="${SOURCE_DB_PASSWORD}" psql \
    -v ON_ERROR_STOP=1 \
    -h "${SOURCE_DB_HOST}" \
    -p "${SOURCE_DB_PORT}" \
    -U "${SOURCE_DB_USER}" \
    -d "${target_db}" \
    "$@"
}

# Расширения из дампа восстанавливаются не через pg_restore: не-trusted
# расширения (например pg_stat_statements) может создавать только
# суперпользователь, а restore идёт с SET ROLE владельца базы. TOC-записи
# EXTENSION/COMMENT вырезаются, расширения заранее создаёт суперпользователь
# — В ТОЙ ЖЕ СХЕМЕ, что и в источнике (WITH SCHEMA из дампа): pg_dump
# рендерит opclass/функции расширения unqualified, если оно живёт в
# pg_catalog (всегда видимом), а pg_restore выполняет restore с пустым
# search_path — расширение в public сломало бы резолв (ADR-49).
precreate_extensions() {
  target_db="$1"
  ext_list_path="$2"

  [ -s "${ext_list_path}" ] || return 0

  while IFS='|' read -r ext_name ext_schema; do
    [ -n "${ext_name}" ] || continue
    log_info "creating extension ${ext_name} (schema ${ext_schema}) in ${target_db} as superuser"
    run_psql_on_db "${target_db}" -v ext_name="${ext_name}" -v ext_schema="${ext_schema}" <<'SQL'
SELECT format('CREATE EXTENSION IF NOT EXISTS %I WITH SCHEMA %I', :'ext_name', :'ext_schema') \gexec
SQL
  done < "${ext_list_path}"
}

# Сводка ошибок pg_restore для diag-вывода: только строки ошибок самого
# pg_restore и итоговое число ignored, без COMMAND/Command was-строк (там
# DDL и произвольные тексты из данных). Fallback на хвост файла — на случай
# нестандартного формата.
summarize_pg_restore_errors() {
  stderr_path="$1"

  summary="$(grep -E '^pg_restore: (error|\[archiver|warning: errors ignored)' "${stderr_path}" | head -n 20 | tr '\n' ' ')"
  if [ -n "${summary}" ]; then
    printf '%s' "${summary}"
    return 0
  fi

  tail -n 3 "${stderr_path}" | tr '\n' ' '
}

# Лок живёт на NFS и переживает под: владелец гарантированно мёртв после
# LOCK_MAX_AGE_SECONDS (activeDeadlineSeconds), брошенный лок забираем сами
acquire_lock() {
  lock_owner="$1"

  if mkdir "${LOCK_DIR}" 2>/dev/null; then
    printf '%s %s\n' "${lock_owner}" "$(date '+%Y-%m-%dT%H:%M:%S%z')" > "${LOCK_DIR}/owner"
    return 0
  fi

  lock_mtime="$(stat -c %Y "${LOCK_DIR}" 2>/dev/null || printf '0')"
  lock_age_seconds=$(( $(date +%s) - lock_mtime ))

  if [ "${lock_age_seconds}" -lt "${LOCK_MAX_AGE_SECONDS}" ]; then
    return 1
  fi

  printf 'stealing stale backup lock %s: age %ss exceeds %ss (previous owner likely killed)\n' \
    "${LOCK_DIR}" "${lock_age_seconds}" "${LOCK_MAX_AGE_SECONDS}" >&2
  rm -rf "${LOCK_DIR}" >/dev/null 2>&1 || true

  if mkdir "${LOCK_DIR}" 2>/dev/null; then
    printf '%s %s (stolen)\n' "${lock_owner}" "$(date '+%Y-%m-%dT%H:%M:%S%z')" > "${LOCK_DIR}/owner"
    return 0
  fi

  return 1
}

release_lock() {
  rm -f "${LOCK_DIR}/owner" >/dev/null 2>&1 || true
  rmdir "${LOCK_DIR}" >/dev/null 2>&1 || true
}

cleanup() {
  rm -rf "${RESTORE_WORK_DIR}" >/dev/null 2>&1 || true
  release_lock
}

if [ -z "${RESTORE_DB_NAME}" ]; then
  printf 'RESTORE_DB_NAME is required\n' >&2
  exit 1
fi

if ! acquire_lock "restore-${RESTORE_DB_NAME}"; then
  printf 'backup lock is currently held by another job\n' >&2
  exit 1
fi

trap cleanup EXIT INT TERM

mkdir -p "${RESTORE_WORK_DIR}"

if [ -n "${RESTORE_BACKUP_NAME}" ]; then
  BACKUP_PATH="${BACKUP_ROOT}/${RESTORE_BACKUP_NAME}"
else
  BACKUP_PATH="$(ls -1dt "${BACKUP_ROOT}"/backup-* 2>/dev/null | head -n 1 || true)"
fi

if [ -z "${BACKUP_PATH}" ]; then
  printf 'no backup directory found in %s\n' "${BACKUP_ROOT}" >&2
  exit 1
fi

BACKUP_NAME="$(basename "${BACKUP_PATH}")"
DB_OWNERS_PATH="${BACKUP_PATH}/db-owners.tsv"
ROLES_SQL_PATH="${BACKUP_PATH}/roles.sql"

if [ ! -d "${BACKUP_PATH}" ]; then
  printf 'backup path %s is not a directory\n' "${BACKUP_NAME}" >&2
  exit 1
fi

if [ ! -f "${DB_OWNERS_PATH}" ]; then
  printf 'backup directory %s does not contain db-owners.tsv\n' "${BACKUP_NAME}" >&2
  exit 1
fi

if [ ! -f "${ROLES_SQL_PATH}" ]; then
  printf 'backup directory %s does not contain roles.sql\n' "${BACKUP_NAME}" >&2
  exit 1
fi

DB_OWNER=''
DUMP_FILE=''
while IFS='|' read -r source_db_name db_owner dump_file; do
  [ -n "${source_db_name}" ] || continue
  if [ "${source_db_name}" = "${RESTORE_DB_NAME}" ]; then
    DB_OWNER="${db_owner}"
    DUMP_FILE="${dump_file}"
    break
  fi
done < "${DB_OWNERS_PATH}"

if [ -z "${DB_OWNER}" ] || [ -z "${DUMP_FILE}" ]; then
  printf 'database %s was not found in backup %s\n' "${RESTORE_DB_NAME}" "${BACKUP_NAME}" >&2
  exit 1
fi

DUMP_PATH="${BACKUP_PATH}/${DUMP_FILE}"

if [ ! -f "${DUMP_PATH}" ]; then
  printf 'dump file %s for database %s is missing\n' "${DUMP_FILE}" "${RESTORE_DB_NAME}" >&2
  exit 1
fi

if [ -s "${ROLES_SQL_PATH}" ]; then
  log_info "restoring roles from ${BACKUP_NAME}"
  run_psql -f "${ROLES_SQL_PATH}" >/dev/null
fi

log_info "dropping and recreating database ${RESTORE_DB_NAME} with owner ${DB_OWNER}"
run_psql \
  -v db_name="${RESTORE_DB_NAME}" \
  -v db_owner="${DB_OWNER}" <<'SQL' >/dev/null
SELECT pg_terminate_backend(pid)
FROM pg_stat_activity
WHERE datname = :'db_name' AND pid <> pg_backend_pid();
SELECT format('DROP DATABASE IF EXISTS %I', :'db_name') \gexec
SELECT format('CREATE DATABASE %I OWNER %I', :'db_name', :'db_owner') \gexec
SQL

toc_path="${RESTORE_WORK_DIR}/toc.txt"
toc_filtered_path="${RESTORE_WORK_DIR}/toc.filtered.txt"
ext_list_path="${RESTORE_WORK_DIR}/extensions.txt"

if ! pg_restore --list "${DUMP_PATH}" > "${toc_path}" 2>/dev/null; then
  printf 'unable to read archive TOC from %s\n' "${DUMP_PATH}" >&2
  exit 1
fi

# Вырезаем EXTENSION/COMMENT-записи: их создаёт precreate_extensions
# суперпользователем; через SET ROLE владельца они бы падали (не-trusted
# расширения) и роняли pg_restore
sed -E \
  -e '/^[0-9]+; [0-9]+ [0-9]+ EXTENSION - /d' \
  -e '/^[0-9]+; [0-9]+ [0-9]+ COMMENT - EXTENSION /d' \
  "${toc_path}" > "${toc_filtered_path}"
# Схема каждого расширения берётся из дампа (--section=pre-data: дёшево,
# без COPY-данных): precreate обязан воспроизвести схему источника
pg_restore -f - --section=pre-data "${DUMP_PATH}" 2>/dev/null \
  | sed -n 's/^CREATE EXTENSION IF NOT EXISTS \([A-Za-z0-9_.-][A-Za-z0-9_.-]*\) WITH SCHEMA \([A-Za-z0-9_]*\);.*/\1|\2/p' \
  > "${ext_list_path}"

if [ -s "${ext_list_path}" ]; then
  log_info "pre-creating extensions for ${RESTORE_DB_NAME}: $(tr '\n' ' ' < "${ext_list_path}")"
  if ! precreate_extensions "${RESTORE_DB_NAME}" "${ext_list_path}"; then
    printf 'unable to pre-create extensions for database %s\n' "${RESTORE_DB_NAME}" >&2
    exit 1
  fi
fi

log_info "restoring database ${RESTORE_DB_NAME} from ${DUMP_FILE}"
pg_restore_stderr_path="${RESTORE_WORK_DIR}/pg_restore.err"

if ! PGPASSWORD="${SOURCE_DB_PASSWORD}" pg_restore \
  -h "${SOURCE_DB_HOST}" \
  -p "${SOURCE_DB_PORT}" \
  -U "${SOURCE_DB_USER}" \
  -d "${RESTORE_DB_NAME}" \
  --clean \
  --if-exists \
  --role="${DB_OWNER}" \
  --no-owner \
  --no-privileges \
  --use-list="${toc_filtered_path}" \
  "${DUMP_PATH}" >/dev/null 2>"${pg_restore_stderr_path}"; then
  printf 'restore failed for %s as %s: %s\n' \
    "${RESTORE_DB_NAME}" "${DB_OWNER}" \
    "$(summarize_pg_restore_errors "${pg_restore_stderr_path}")" >&2
  exit 1
fi

log_info "database ${RESTORE_DB_NAME} successfully restored from ${BACKUP_NAME}"
