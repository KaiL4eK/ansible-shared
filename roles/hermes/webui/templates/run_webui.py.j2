#!/usr/bin/env python3
import base64
import os
import sys

with open({{ hermes_webui_environment_file | to_json }}, encoding="utf-8") as environment_file:
    encoded_password = environment_file.read().strip().partition("=")[2]

os.environ["HERMES_WEBUI_PASSWORD"] = base64.b64decode(
    encoded_password, validate=True
).decode("utf-8")

webui_directory = {{ hermes_webui_install_directory | to_json }}
os.chdir(webui_directory)
os.execv(
    sys.executable,
    [
        sys.executable,
        os.path.join(webui_directory, "bootstrap.py"),
        "--host",
        {{ hermes_webui_host | to_json }},
        "--foreground",
        "--skip-agent-install",
        str({{ hermes_webui_port | int }}),
    ],
)
