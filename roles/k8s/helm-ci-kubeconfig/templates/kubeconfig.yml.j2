apiVersion: v1
kind: Config
current-context: {{ k8s_helm_ci_name | to_json }}
clusters:
  - name: {{ k8s_helm_ci_source_context.cluster | to_json }}
    cluster:
      server: {{ k8s_helm_ci_source_cluster.server | to_json }}
      certificate-authority-data: {{ k8s_helm_ci_source_cluster['certificate-authority-data'] | to_json }}
contexts:
  - name: {{ k8s_helm_ci_name | to_json }}
    context:
      cluster: {{ k8s_helm_ci_source_context.cluster | to_json }}
      namespace: {{ k8s_helm_ci_namespace | to_json }}
      user: {{ k8s_helm_ci_name | to_json }}
users:
  - name: {{ k8s_helm_ci_name | to_json }}
    user:
      token: {{ k8s_helm_ci_token_secret.resources[0].data.token | b64decode | to_json }}
