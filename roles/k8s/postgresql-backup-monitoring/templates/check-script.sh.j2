#!/bin/sh
set -eu

BACKUP_ROOT="${BACKUP_ROOT:-{{ backup_monitoring_backup_root }}}"
LOCK_DIR_NAME="${LOCK_DIR_NAME:-{{ backup_monitoring_lock_dir_name }}}"
LOCK_DIR="${BACKUP_ROOT}/${LOCK_DIR_NAME}"
WORK_DIR="/tmp/backup-check-$$"
LATEST_BACKUP=""
LATEST_MTIME=""
LATEST_BACKUP_PATH=""
CURRENT_RESTORE_DB=""

log_info() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

format_duration() {
  duration_seconds="$1"
  hours=$((duration_seconds / 3600))
  minutes=$(((duration_seconds % 3600) / 60))
  seconds=$((duration_seconds % 60))

  if [ "${hours}" -gt 0 ]; then
    printf '%dh %02dm %02ds' "${hours}" "${minutes}" "${seconds}"
    return 0
  fi

  if [ "${minutes}" -gt 0 ]; then
    printf '%dm %02ds' "${minutes}" "${seconds}"
    return 0
  fi

  printf '%ds' "${seconds}"
}

run_psql() {
  PGPASSWORD="${CHECK_DB_PASSWORD}" psql \
    -v ON_ERROR_STOP=1 \
    -h "${CHECK_DB_HOST}" \
    -p "${CHECK_DB_PORT}" \
    -U "${CHECK_DB_USER}" \
    -d "${CHECK_DB_NAME}" \
    "$@"
}

ensure_results_table() {
  attempt=1
  max_attempts=30

  while [ "${attempt}" -le "${max_attempts}" ]; do
    if run_psql <<'SQL' >/dev/null 2>&1; then
CREATE TABLE IF NOT EXISTS backup_verification_results (
  id BIGSERIAL PRIMARY KEY,
  checked_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  status TEXT NOT NULL,
  backup_file TEXT,
  backup_mtime TIMESTAMPTZ,
  details TEXT NOT NULL
);
SQL
      return 0
    fi

    if [ "${attempt}" -eq "${max_attempts}" ]; then
      break
    fi

    attempt=$((attempt + 1))
    sleep 10
  done

  printf 'unable to ensure backup_verification_results table in verification database\n' >&2
  exit 1
}

build_restore_db_name() {
  source_db_name="$1"
  safe_name="$(printf '%s' "${source_db_name}" | tr -c '[:alnum:]' '_' | cut -c1-40)"
  db_hash="$(printf '%s' "${source_db_name}" | cksum | cut -d' ' -f1)"
  printf 'restore_%s_%s' "${safe_name}" "${db_hash}"
}

drop_restore_db() {
  restore_db_name="$1"

  [ -n "${restore_db_name}" ] || return 0

  run_psql \
    -v db_name="${restore_db_name}" <<'SQL' >/dev/null 2>&1 || true
SELECT pg_terminate_backend(pid)
FROM pg_stat_activity
WHERE datname = :'db_name' AND pid <> pg_backend_pid();
SELECT format('DROP DATABASE IF EXISTS %I', :'db_name') \gexec
SQL
}

create_restore_db() {
  restore_db_name="$1"
  db_owner="$2"

  drop_restore_db "${restore_db_name}"

  run_psql \
    -v db_name="${restore_db_name}" \
    -v db_owner="${db_owner}" <<'SQL' >/dev/null
SELECT format('CREATE DATABASE %I OWNER %I', :'db_name', :'db_owner') \gexec
SQL
}

get_db_owner() {
  restore_db_name="$1"

  run_psql \
    -At \
    -v db_name="${restore_db_name}" <<'SQL'
SELECT pg_get_userbyid(datdba)
FROM pg_database
WHERE datname = :'db_name';
SQL
}

get_table_count() {
  restore_db_name="$1"

  PGPASSWORD="${CHECK_DB_PASSWORD}" psql \
    -At \
    -h "${CHECK_DB_HOST}" \
    -p "${CHECK_DB_PORT}" \
    -U "${CHECK_DB_USER}" \
    -d "${restore_db_name}" <<'SQL'
SELECT count(*)
FROM pg_class AS c
JOIN pg_namespace AS n ON n.oid = c.relnamespace
WHERE c.relkind IN ('r', 'p')
  AND n.nspname NOT IN ('pg_catalog', 'information_schema')
  AND n.nspname !~ '^pg_toast';
SQL
}

sanitize_json() {
  printf '%s' "$1" | tr '\n' ' ' | sed 's/\\/\\\\/g; s/"/\\"/g'
}

log_result() {
  status="$1"
  details="$2"
  backup_file="$3"
  backup_mtime="$4"

  run_psql \
    -v status="${status}" \
    -v backup_file="${backup_file}" \
    -v backup_mtime="${backup_mtime}" \
    -v details="${details}" <<'SQL' >/dev/null 2>&1 || true
INSERT INTO backup_verification_results (status, backup_file, backup_mtime, details)
VALUES (
  :'status',
  NULLIF(:'backup_file', ''),
  CASE
    WHEN NULLIF(:'backup_mtime', '') IS NULL THEN NULL
    ELSE (:'backup_mtime')::timestamptz
  END,
  :'details'
);
SQL
}

send_webhook() {
  webhook_url="$1"
  payload="$2"

  [ -n "${webhook_url}" ] || return 0

  if command -v apk >/dev/null 2>&1; then
    apk add --no-cache curl >/dev/null 2>&1 || true
  fi

  curl -fsS -X POST \
    -H 'Content-Type: application/json' \
    -d "${payload}" \
    "${webhook_url}" >/dev/null 2>&1 || true
}

notify_failure() {
  status="$1"
  details="$2"
  backup_file="$3"

  if [ "${status}" = "ok" ] || [ "${status}" = "skipped_locked" ]; then
    return 0
  fi

  safe_text="$(sanitize_json "backup verification failed on $(hostname): ${status}; backup=${backup_file:-none}; details=${details}")"
  mattermost_payload="{\"text\":\"${safe_text}\"}"
  teams_payload="{\"text\":\"${safe_text}\"}"

  send_webhook "${MATTERMOST_WEBHOOK_URL}" "${mattermost_payload}"
  send_webhook "${TEAMS_WEBHOOK_URL}" "${teams_payload}"
}

cleanup() {
  drop_restore_db "${CURRENT_RESTORE_DB}"
  rm -rf "${WORK_DIR}" >/dev/null 2>&1 || true
  rmdir "${LOCK_DIR}" >/dev/null 2>&1 || true
}

finish() {
  status="$1"
  details="$2"
  log_result "${status}" "${details}" "${LATEST_BACKUP}" "${LATEST_MTIME}"
  notify_failure "${status}" "${details}" "${LATEST_BACKUP}"
  cleanup

  if [ "${status}" = "ok" ] || [ "${status}" = "skipped_locked" ]; then
    exit 0
  fi

  exit 1
}

if [ -d "${LOCK_DIR}" ]; then
  finish "skipped_locked" "backup lock is currently held by another job"
fi

if ! mkdir "${LOCK_DIR}" 2>/dev/null; then
  finish "skipped_locked" "failed to acquire backup lock"
fi

ensure_results_table

LATEST_BACKUP_PATH="$(ls -1dt "${BACKUP_ROOT}"/backup-* 2>/dev/null | head -n 1 || true)"

if [ -z "${LATEST_BACKUP_PATH}" ]; then
  finish "failed" "no backup directory found in ${BACKUP_ROOT}"
fi

LATEST_BACKUP="$(basename "${LATEST_BACKUP_PATH}")"
LATEST_MTIME="$(stat -c '%y' "${LATEST_BACKUP_PATH}" 2>/dev/null | cut -d'.' -f1 || true)"

if [ ! -d "${LATEST_BACKUP_PATH}" ]; then
  finish "failed" "backup path ${LATEST_BACKUP} is not a directory"
fi

ARCHIVE_DIR="${LATEST_BACKUP_PATH}"
DB_OWNERS_PATH="${ARCHIVE_DIR}/db-owners.tsv"
ROLES_SQL_PATH="${ARCHIVE_DIR}/roles.sql"

if [ ! -f "${DB_OWNERS_PATH}" ]; then
  finish "failed" "backup directory ${LATEST_BACKUP} does not contain db-owners.tsv"
fi

if [ ! -f "${ROLES_SQL_PATH}" ]; then
  finish "failed" "backup directory ${LATEST_BACKUP} does not contain roles.sql"
fi

if [ -s "${ROLES_SQL_PATH}" ]; then
  if ! run_psql -f "${ROLES_SQL_PATH}" >/dev/null 2>&1; then
    finish "failed" "unable to restore roles from ${LATEST_BACKUP}"
  fi
fi

DUMP_COUNT=0
while IFS='|' read -r source_db_name db_owner dump_file; do
  [ -n "${source_db_name}" ] || continue
  DUMP_COUNT=$((DUMP_COUNT + 1))
  dump_path="${ARCHIVE_DIR}/${dump_file}"
  CURRENT_RESTORE_DB="$(build_restore_db_name "${source_db_name}")"
  restore_started_at="$(date +%s)"

  log_info "starting verification restore for database ${source_db_name} from ${dump_file}"

  if [ ! -f "${dump_path}" ]; then
    finish "failed" "dump file ${dump_file} for database ${source_db_name} is missing"
  fi

  if ! create_restore_db "${CURRENT_RESTORE_DB}" "${db_owner}"; then
    finish "failed" "unable to create restore database for ${source_db_name} owned by ${db_owner}"
  fi

  if ! PGPASSWORD="${CHECK_DB_PASSWORD}" pg_restore \
    -h "${CHECK_DB_HOST}" \
    -p "${CHECK_DB_PORT}" \
    -U "${CHECK_DB_USER}" \
    -d "${CURRENT_RESTORE_DB}" \
    --clean \
    --if-exists \
    --role="${db_owner}" \
    --no-owner \
    --no-privileges \
    "${dump_path}" >/dev/null 2>&1; then
    finish "failed" "restore failed for ${source_db_name} as ${db_owner}"
  fi

  actual_owner="$(get_db_owner "${CURRENT_RESTORE_DB}")"
  if [ "${actual_owner}" != "${db_owner}" ]; then
    finish "failed" "database ${source_db_name} restored with owner ${actual_owner}, expected ${db_owner}"
  fi

  if ! PGPASSWORD="${CHECK_DB_PASSWORD}" psql \
    -h "${CHECK_DB_HOST}" \
    -p "${CHECK_DB_PORT}" \
    -U "${CHECK_DB_USER}" \
    -d "${CURRENT_RESTORE_DB}" \
    -v ON_ERROR_STOP=1 \
    -c 'SELECT 1;' >/dev/null 2>&1; then
    finish "failed" "smoke query failed after restore of ${source_db_name}"
  fi

  restored_table_count="$(get_table_count "${CURRENT_RESTORE_DB}")"
  restore_finished_at="$(date +%s)"
  restore_duration="$((restore_finished_at - restore_started_at))"
  log_info "finished verification restore for database ${source_db_name}: duration=$(format_duration "${restore_duration}"), restored_tables=${restored_table_count}"

  drop_restore_db "${CURRENT_RESTORE_DB}"
  CURRENT_RESTORE_DB=""
done < "${DB_OWNERS_PATH}"

if [ "${DUMP_COUNT}" -eq 0 ]; then
  finish "failed" "backup directory ${LATEST_BACKUP} does not contain databases to verify"
fi

finish "ok" "verified ${DUMP_COUNT} databases with restored roles from ${LATEST_BACKUP}"
