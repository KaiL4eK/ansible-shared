#!/bin/sh
set -eu

BACKUP_ROOT="${BACKUP_ROOT:-{{ minio_backup_monitoring_backup_root }}}"
LOCK_DIR_NAME="${LOCK_DIR_NAME:-{{ minio_backup_monitoring_lock_dir_name }}}"
LOCK_MAX_AGE_SECONDS="${LOCK_MAX_AGE_SECONDS:-{{ minio_backup_monitoring_lock_max_age_seconds }}}"
FREE_SPACE_HEADROOM_PERCENT="${FREE_SPACE_HEADROOM_PERCENT:-{{ minio_backup_monitoring_free_space_headroom_percent }}}"
FREE_SPACE_MIN_RESERVE_BYTES="${FREE_SPACE_MIN_RESERVE_BYTES:-{{ minio_backup_monitoring_free_space_min_reserve_bytes }}}"
LOCK_DIR="${BACKUP_ROOT}/${LOCK_DIR_NAME}"
BACKUP_RETENTION_COUNT="${BACKUP_RETENTION_COUNT:-{{ minio_backup_monitoring_backup_retention_count }}}"
SOURCE_ALIAS="${SOURCE_ALIAS:-{{ minio_backup_monitoring_source_alias }}}"
TIMESTAMP="$(date +%Y%m%d-%H%M%S)"
STAGING_DIR="${BACKUP_ROOT}/.staging-backup-${TIMESTAMP}"
FINAL_BACKUP_DIR="${BACKUP_ROOT}/backup-${TIMESTAMP}"
METADATA_DIR="${STAGING_DIR}/metadata"
LISTINGS_DIR="${STAGING_DIR}/listings"
BUCKETS_JSON_PATH="${STAGING_DIR}/.buckets.json"
BUCKETS_PATH="${STAGING_DIR}/.buckets.txt"
BUCKETS_TSV_PATH="${STAGING_DIR}/buckets.tsv"
BACKUP_META_PATH="${STAGING_DIR}/backup-meta.txt"
MIRRORED_BUCKET_COUNT=0
ACQUIRED_LOCK=0

log_info() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

format_duration() {
  duration_seconds="$1"
  hours=$((duration_seconds / 3600))
  minutes=$(((duration_seconds % 3600) / 60))
  seconds=$((duration_seconds % 60))

  if [ "${hours}" -gt 0 ]; then
    printf '%dh %02dm %02ds' "${hours}" "${minutes}" "${seconds}"
    return 0
  fi

  if [ "${minutes}" -gt 0 ]; then
    printf '%dm %02ds' "${minutes}" "${seconds}"
    return 0
  fi

  printf '%ds' "${seconds}"
}

format_size() {
  size_bytes="$1"

  if [ "${size_bytes}" -ge 1073741824 ]; then
    printf '%s GiB' "$(awk "BEGIN { printf \"%.2f\", ${size_bytes} / 1073741824 }")"
    return 0
  fi

  if [ "${size_bytes}" -ge 1048576 ]; then
    printf '%s MiB' "$(awk "BEGIN { printf \"%.2f\", ${size_bytes} / 1048576 }")"
    return 0
  fi

  if [ "${size_bytes}" -ge 1024 ]; then
    printf '%s KiB' "$(awk "BEGIN { printf \"%.2f\", ${size_bytes} / 1024 }")"
    return 0
  fi

  printf '%s B' "${size_bytes}"
}

# Лок живёт на NFS и переживает под: если владелец убит (activeDeadlineSeconds
# гарантирует смерть раньше LOCK_MAX_AGE_SECONDS), лок считается брошенным и
# захватывается следующим джобом с warning. owner-файл фиксирует, кто держит лок
acquire_lock() {
  lock_owner="$1"

  if mkdir "${LOCK_DIR}" 2>/dev/null; then
    printf '%s %s\n' "${lock_owner}" "$(date '+%Y-%m-%dT%H:%M:%S%z')" > "${LOCK_DIR}/owner"
    return 0
  fi

  lock_mtime="$(stat -c %Y "${LOCK_DIR}" 2>/dev/null || printf '0')"
  lock_age_seconds=$(( $(date +%s) - lock_mtime ))

  if [ "${lock_age_seconds}" -lt "${LOCK_MAX_AGE_SECONDS}" ]; then
    return 1
  fi

  printf 'stealing stale backup lock %s: age %ss exceeds %ss (previous owner likely killed)\n' \
    "${LOCK_DIR}" "${lock_age_seconds}" "${LOCK_MAX_AGE_SECONDS}" >&2
  rm -rf "${LOCK_DIR}" >/dev/null 2>&1 || true

  if mkdir "${LOCK_DIR}" 2>/dev/null; then
    printf '%s %s (stolen)\n' "${lock_owner}" "$(date '+%Y-%m-%dT%H:%M:%S%z')" > "${LOCK_DIR}/owner"
    return 0
  fi

  return 1
}

release_lock() {
  rm -f "${LOCK_DIR}/owner" >/dev/null 2>&1 || true
  rmdir "${LOCK_DIR}" >/dev/null 2>&1 || true
}

# Оценка потребности по предыдущей копии (buckets.tsv): доступного места на
# BACKUP_ROOT должно хватать на размер + headroom + резерв. Первая копия
# оценки не имеет — пропускаем
ensure_free_space() {
  latest_backup_dir="$(ls -1dt "${BACKUP_ROOT}"/backup-* 2>/dev/null | head -n 1 || true)"

  if [ -z "${latest_backup_dir}" ] || [ ! -f "${latest_backup_dir}/buckets.tsv" ]; then
    return 0
  fi

  estimated_bytes="$(awk -F'|' 'NF >= 3 { total += $3 } END { printf "%d", total + 0 }' \
    "${latest_backup_dir}/buckets.tsv")"

  if [ "${estimated_bytes}" -le 0 ]; then
    return 0
  fi

  required_bytes=$(( estimated_bytes * (100 + FREE_SPACE_HEADROOM_PERCENT) / 100 + FREE_SPACE_MIN_RESERVE_BYTES ))
  available_bytes="$(df -Pk "${BACKUP_ROOT}" 2>/dev/null | awk 'NR == 2 { printf "%d", $4 * 1024 }')"

  if [ -z "${available_bytes}" ] || [ "${available_bytes}" -le 0 ]; then
    return 0
  fi

  if [ "${available_bytes}" -lt "${required_bytes}" ]; then
    printf 'not enough free space on %s: available %s, required %s (previous backup %s + %s%% headroom + %s reserve)\n' \
      "${BACKUP_ROOT}" \
      "$(format_size "${available_bytes}")" \
      "$(format_size "${required_bytes}")" \
      "$(format_size "${estimated_bytes}")" \
      "${FREE_SPACE_HEADROOM_PERCENT}" \
      "$(format_size "${FREE_SPACE_MIN_RESERVE_BYTES}")" >&2
    return 1
  fi

  return 0
}

cleanup() {
  if [ -n "${STAGING_DIR}" ] && [ -d "${STAGING_DIR}" ]; then
    rm -rf "${STAGING_DIR}" >/dev/null 2>&1 || true
  fi
  if [ "${ACQUIRED_LOCK}" = "1" ]; then
    release_lock
  fi
}

prune_old_backups() {
  backup_index=0

  for backup_dir in $(ls -1dt "${BACKUP_ROOT}"/backup-* 2>/dev/null); do
    [ -d "${backup_dir}" ] || continue
    backup_index=$((backup_index + 1))

    if [ "${backup_index}" -le "${BACKUP_RETENTION_COUNT}" ]; then
      continue
    fi

    rm -rf "${backup_dir}" >/dev/null 2>&1 || true
  done
}

sanitize_json() {
  printf '%s' "$1" | tr '\n' ' ' | sed 's/\\/\\\\/g; s/"/\\"/g'
}

# Падение бэкапа алертится сразу отсюда: без этого check узнал бы о нём
# только через stale-порог свежести (дни). Причина провала всегда попадает
# в логи пода — карточка ссылается на них
notify_failure() {
  exit_code="$1"

  if [ -z "${TEAMS_WEBHOOK_URL:-}" ]; then
    return 0
  fi

  safe_hostname="$(sanitize_json "$(hostname)")"
  safe_backup="$(sanitize_json "backup-${TIMESTAMP}")"
  payload=$(cat <<EOF
{"@type":"MessageCard","@context":"https://schema.org/extensions","themeColor":"E81123","summary":"MinIO backup failed","title":"MinIO backup failed","sections":[{"facts":[{"name":"Host","value":"${safe_hostname}"},{"name":"Status","value":"failed (exit ${exit_code})"},{"name":"Backup","value":"${safe_backup}"}],"text":"MinIO backup job failed with exit code ${exit_code}. See the job pod logs for the failing step."}]}
EOF
)

  if ! command -v curl >/dev/null 2>&1 && command -v apk >/dev/null 2>&1; then
    apk add --no-cache curl >/dev/null 2>&1 || true
  fi

  # Таймауты обязательны: EXIT-трап ждёт curl, зависший POST задержал бы
  # выход джоба и освобождение NFS-лока вплоть до activeDeadlineSeconds
  curl -fsS --connect-timeout 5 --max-time 15 -X POST \
    -H 'Content-Type: application/json' \
    -d "${payload}" \
    "${TEAMS_WEBHOOK_URL}" >/dev/null 2>&1 \
    || printf 'teams notification was not sent (curl unavailable or webhook request failed)\n' >&2
}

on_exit() {
  exit_code="$1"

  if [ "${exit_code}" -ne 0 ]; then
    notify_failure "${exit_code}"
  fi

  cleanup
}

# Трапы ставятся до JOB_PACKAGES и проверки mc: уведомлять нужно и о ранних
# падениях (пакеты не установились, занят лок). INT/TERM переведены в явный
# exit, чтобы EXIT-трап увидел ненулевой код при убийстве пода
# activeDeadlineSeconds
trap 'on_exit $?' EXIT
trap 'exit 143' TERM
trap 'exit 130' INT

if [ -n "${JOB_PACKAGES:-}" ]; then
  apk add --no-cache ${JOB_PACKAGES} >/dev/null
fi

# Alpine пакует MinIO client с бинарником mcli — переименование из-за конфликта
# с midnight commander (minio/mc CONFLICT.md). Приводим к каноничному имени mc,
# остальной скрипт работает только с ним
if ! command -v mc >/dev/null 2>&1 && command -v mcli >/dev/null 2>&1; then
  ln -sf "$(command -v mcli)" /usr/local/bin/mc
fi

command -v mc >/dev/null 2>&1 || {
  printf 'mc client is not available in the job image (alpine minio-client installs mcli; expected mc or mcli on PATH)\n' >&2
  exit 1
}

if ! acquire_lock "backup-${TIMESTAMP}"; then
  printf 'backup lock is already held in %s\n' "${LOCK_DIR}" >&2
  exit 1
fi

ACQUIRED_LOCK=1

mc alias set "${SOURCE_ALIAS}" \
  "${SOURCE_MINIO_ENDPOINT}" \
  "${SOURCE_MINIO_ACCESS_KEY}" \
  "${SOURCE_MINIO_SECRET_KEY}" >/dev/null

mkdir -p "${METADATA_DIR}" "${LISTINGS_DIR}"

if ! ensure_free_space; then
  exit 1
fi

# JSON вместо парсинга текстового вывода mc: формат колонок плавает между
# версиями, а версия клиента — за alpine-репозиторием
mc ls --json "${SOURCE_ALIAS}/" > "${BUCKETS_JSON_PATH}"

raw_listing_count="$(wc -l < "${BUCKETS_JSON_PATH}" | tr -d '[:space:]')"
if [ "${raw_listing_count}" -eq 0 ]; then
  printf 'no buckets found on source MinIO instance\n' >&2
  exit 1
fi

jq -r 'select(.type == "folder") | .key | rtrimstr("/")' "${BUCKETS_JSON_PATH}" > "${BUCKETS_PATH}"

bucket_count="$(wc -l < "${BUCKETS_PATH}" | tr -d '[:space:]')"
if [ "${bucket_count}" -eq 0 ]; then
  printf 'bucket discovery failed: mc ls --json returned %s entries but none parsed as folders\n' "${raw_listing_count}" >&2
  exit 1
fi

: > "${BUCKETS_TSV_PATH}"
while IFS= read -r bucket_name; do
  [ -n "${bucket_name}" ] || continue
  bucket_dir="${STAGING_DIR}/${bucket_name}"
  mirror_started_at="$(date +%s)"

  log_info "starting mirror for bucket ${bucket_name}"

  mc mirror --overwrite "${SOURCE_ALIAS}/${bucket_name}" "${bucket_dir}/"

  object_count="$(find "${bucket_dir}" -type f | wc -l | tr -d '[:space:]')"
  total_bytes="$(du -sb "${bucket_dir}" | cut -f1)"

  (cd "${bucket_dir}" && find . -type f | sort) > "${LISTINGS_DIR}/${bucket_name}.listing.txt"
  (cd "${bucket_dir}" && find . -type f -print0 | sort -z | xargs -0 -r md5sum) > "${LISTINGS_DIR}/${bucket_name}.md5"

  printf '%s|%s|%s\n' "${bucket_name}" "${object_count}" "${total_bytes}" >> "${BUCKETS_TSV_PATH}"

  MIRRORED_BUCKET_COUNT=$((MIRRORED_BUCKET_COUNT + 1))
  mirror_finished_at="$(date +%s)"
  mirror_duration="$((mirror_finished_at - mirror_started_at))"
  log_info "finished mirror for bucket ${bucket_name}: duration=$(format_duration "${mirror_duration}"), objects=${object_count}, size=$(format_size "${total_bytes}")"
done < "${BUCKETS_PATH}"

if [ ! -s "${BUCKETS_TSV_PATH}" ]; then
  printf 'no buckets were mirrored\n' >&2
  exit 1
fi

log_info "exporting bucket metadata"
bucket_export_dir="${METADATA_DIR}/.bucket-export"
mkdir -p "${bucket_export_dir}"
(
  cd "${bucket_export_dir}" &&
    mc admin cluster bucket export "${SOURCE_ALIAS}"
)

bucket_metadata_zip="$(ls -1 "${bucket_export_dir}"/*.zip 2>/dev/null | head -n 1 || true)"
if [ -z "${bucket_metadata_zip}" ]; then
  printf 'bucket metadata export did not produce an archive\n' >&2
  exit 1
fi
mv "${bucket_metadata_zip}" "${METADATA_DIR}/bucket-metadata.zip"
rm -rf "${bucket_export_dir}"

log_info "exporting IAM metadata"
mc admin cluster iam export "${SOURCE_ALIAS}" --output "${METADATA_DIR}/iam-metadata.zip"

log_info "exporting cluster configuration"
mc admin config export "${SOURCE_ALIAS}" > "${METADATA_DIR}/cluster-config.txt"

for metadata_zip in "${METADATA_DIR}"/*.zip; do
  if ! unzip -t "${metadata_zip}" >/dev/null 2>&1; then
    printf 'metadata archive %s is corrupt\n' "$(basename "${metadata_zip}")" >&2
    exit 1
  fi
done

if [ ! -s "${METADATA_DIR}/cluster-config.txt" ]; then
  printf 'cluster configuration export is empty\n' >&2
  exit 1
fi

mc --version | head -n 1 > "${BACKUP_META_PATH}"
printf 'backup_completed_at=%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" >> "${BACKUP_META_PATH}"
printf 'source_endpoint=%s\n' "${SOURCE_MINIO_ENDPOINT}" >> "${BACKUP_META_PATH}"
printf 'source_alias=%s\n' "${SOURCE_ALIAS}" >> "${BACKUP_META_PATH}"
printf 'mirrored_buckets=%s\n' "${MIRRORED_BUCKET_COUNT}" >> "${BACKUP_META_PATH}"

rm -f "${BUCKETS_PATH}" "${BUCKETS_JSON_PATH}"
mv "${STAGING_DIR}" "${FINAL_BACKUP_DIR}"
STAGING_DIR=""

log_info "backup stored in ${FINAL_BACKUP_DIR}"
backup_total_size_bytes="$(du -sb "${FINAL_BACKUP_DIR}" | cut -f1)"
log_info "backup summary: buckets=${MIRRORED_BUCKET_COUNT}, total_size=$(format_size "${backup_total_size_bytes}")"

prune_old_backups
