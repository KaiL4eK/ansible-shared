#!/bin/sh
set -eu

BACKUP_ROOT="${BACKUP_ROOT:-{{ minio_backup_monitoring_backup_root }}}"
LOCK_DIR_NAME="${LOCK_DIR_NAME:-{{ minio_backup_monitoring_lock_dir_name }}}"
LOCK_DIR="${BACKUP_ROOT}/${LOCK_DIR_NAME}"
VERIFICATION_RESULTS_FILE="${VERIFICATION_RESULTS_FILE:-{{ minio_backup_monitoring_verification_results_file }}}"
LATEST_BACKUP=""
LATEST_BACKUP_PATH=""
ACQUIRED_LOCK=0

log_info() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

format_size() {
  size_bytes="$1"

  if [ "${size_bytes}" -ge 1073741824 ]; then
    printf '%s GiB' "$(awk "BEGIN { printf \"%.2f\", ${size_bytes} / 1073741824 }")"
    return 0
  fi

  if [ "${size_bytes}" -ge 1048576 ]; then
    printf '%s MiB' "$(awk "BEGIN { printf \"%.2f\", ${size_bytes} / 1048576 }")"
    return 0
  fi

  if [ "${size_bytes}" -ge 1024 ]; then
    printf '%s KiB' "$(awk "BEGIN { printf \"%.2f\", ${size_bytes} / 1024 }")"
    return 0
  fi

  printf '%s B' "${size_bytes}"
}

sanitize_json() {
  printf '%s' "$1" | tr '\n' ' ' | sed 's/\\/\\\\/g; s/"/\\"/g'
}

record_result() {
  status="$1"
  details="$2"
  backup_name="$3"

  safe_status="$(sanitize_json "${status}")"
  safe_details="$(sanitize_json "${details}")"
  safe_backup="$(sanitize_json "${backup_name:-none}")"

  printf '{"checked_at":"%s","status":"%s","backup":"%s","details":"%s"}\n' \
    "$(date '+%Y-%m-%dT%H:%M:%S%z')" \
    "${safe_status}" \
    "${safe_backup}" \
    "${safe_details}" \
    >> "${BACKUP_ROOT}/${VERIFICATION_RESULTS_FILE}" 2>/dev/null || true
}

notify_failure() {
  status="$1"
  details="$2"
  backup_name="$3"

  if [ "${status}" = "ok" ] || [ "${status}" = "skipped_locked" ] || [ -z "${TEAMS_WEBHOOK_URL:-}" ]; then
    return 0
  fi

  safe_hostname="$(sanitize_json "$(hostname)")"
  safe_status="$(sanitize_json "${status}")"
  safe_backup="$(sanitize_json "${backup_name:-none}")"
  safe_details="$(sanitize_json "${details}")"
  payload=$(cat <<EOF
{"@type":"MessageCard","@context":"https://schema.org/extensions","themeColor":"E81123","summary":"MinIO backup verification failed","title":"MinIO backup verification failed","sections":[{"facts":[{"name":"Host","value":"${safe_hostname}"},{"name":"Status","value":"${safe_status}"},{"name":"Backup","value":"${safe_backup}"}],"text":"${safe_details}"}]}
EOF
)

  curl -fsS -X POST \
    -H 'Content-Type: application/json' \
    -d "${payload}" \
    "${TEAMS_WEBHOOK_URL}" >/dev/null 2>&1 || true
}

cleanup() {
  if [ "${ACQUIRED_LOCK}" = "1" ]; then
    rmdir "${LOCK_DIR}" >/dev/null 2>&1 || true
  fi
}

finish() {
  status="$1"
  details="$2"
  record_result "${status}" "${details}" "${LATEST_BACKUP}"
  notify_failure "${status}" "${details}" "${LATEST_BACKUP}"
  cleanup

  if [ "${status}" = "ok" ] || [ "${status}" = "skipped_locked" ]; then
    exit 0
  fi

  exit 1
}

if [ -n "${JOB_PACKAGES:-}" ]; then
  apk add --no-cache ${JOB_PACKAGES} >/dev/null
fi

if [ -d "${LOCK_DIR}" ]; then
  finish "skipped_locked" "backup lock is currently held by another job"
fi

if ! mkdir "${LOCK_DIR}" 2>/dev/null; then
  finish "skipped_locked" "failed to acquire backup lock"
fi

ACQUIRED_LOCK=1

LATEST_BACKUP_PATH="$(ls -1dt "${BACKUP_ROOT}"/backup-* 2>/dev/null | head -n 1 || true)"

if [ -z "${LATEST_BACKUP_PATH}" ]; then
  finish "failed" "no backup directory found in ${BACKUP_ROOT}"
fi

LATEST_BACKUP="$(basename "${LATEST_BACKUP_PATH}")"

if [ ! -d "${LATEST_BACKUP_PATH}" ]; then
  finish "failed" "backup path ${LATEST_BACKUP} is not a directory"
fi

BUCKETS_TSV_PATH="${LATEST_BACKUP_PATH}/buckets.tsv"
BACKUP_META_PATH="${LATEST_BACKUP_PATH}/backup-meta.txt"
METADATA_DIR="${LATEST_BACKUP_PATH}/metadata"

if [ ! -f "${BUCKETS_TSV_PATH}" ]; then
  finish "failed" "backup directory ${LATEST_BACKUP} does not contain buckets.tsv"
fi

if [ ! -f "${BACKUP_META_PATH}" ]; then
  finish "failed" "backup directory ${LATEST_BACKUP} does not contain backup-meta.txt"
fi

if [ ! -f "${METADATA_DIR}/bucket-metadata.zip" ]; then
  finish "failed" "backup directory ${LATEST_BACKUP} does not contain metadata/bucket-metadata.zip"
fi

if [ ! -f "${METADATA_DIR}/iam-metadata.zip" ]; then
  finish "failed" "backup directory ${LATEST_BACKUP} does not contain metadata/iam-metadata.zip"
fi

if [ ! -f "${METADATA_DIR}/cluster-config.txt" ]; then
  finish "failed" "backup directory ${LATEST_BACKUP} does not contain metadata/cluster-config.txt"
fi

for metadata_zip in "${METADATA_DIR}"/*.zip; do
  if ! unzip -t "${metadata_zip}" >/dev/null 2>&1; then
    finish "failed" "metadata archive $(basename "${metadata_zip}") in ${LATEST_BACKUP} is corrupt"
  fi
done

if [ ! -s "${METADATA_DIR}/cluster-config.txt" ]; then
  finish "failed" "cluster configuration export in ${LATEST_BACKUP} is empty"
fi

CHECKED_BUCKET_COUNT=0
while IFS='|' read -r bucket_name object_count total_bytes; do
  [ -n "${bucket_name}" ] || continue
  CHECKED_BUCKET_COUNT=$((CHECKED_BUCKET_COUNT + 1))
  bucket_dir="${LATEST_BACKUP_PATH}/${bucket_name}"
  listing_path="${LATEST_BACKUP_PATH}/listings/${bucket_name}.listing.txt"

  log_info "verifying bucket ${bucket_name}"

  if [ ! -d "${bucket_dir}" ]; then
    finish "failed" "bucket directory ${bucket_name} is missing in ${LATEST_BACKUP}"
  fi

  if [ ! -f "${listing_path}" ]; then
    finish "failed" "object listing for bucket ${bucket_name} is missing in ${LATEST_BACKUP}"
  fi

  actual_count="$(find "${bucket_dir}" -type f | wc -l | tr -d '[:space:]')"
  if [ "${actual_count}" != "${object_count}" ]; then
    finish "failed" "object count mismatch for bucket ${bucket_name}: expected ${object_count}, found ${actual_count}"
  fi

  actual_bytes="$(du -sb "${bucket_dir}" | cut -f1)"
  if [ "${actual_bytes}" != "${total_bytes}" ]; then
    finish "failed" "size mismatch for bucket ${bucket_name}: expected $(format_size "${total_bytes}"), found $(format_size "${actual_bytes}")"
  fi

  regenerated_listing="$(cd "${bucket_dir}" && find . -type f | sort)"
  recorded_listing="$(cat "${listing_path}")"
  if [ "${regenerated_listing}" != "${recorded_listing}" ]; then
    finish "failed" "object listing for bucket ${bucket_name} no longer matches the backup manifest"
  fi

  log_info "bucket ${bucket_name} verified: objects=${object_count}, size=$(format_size "${total_bytes}")"
done < "${BUCKETS_TSV_PATH}"

if [ "${CHECKED_BUCKET_COUNT}" -eq 0 ]; then
  finish "failed" "backup directory ${LATEST_BACKUP} does not contain buckets to verify"
fi

finish "ok" "verified ${CHECKED_BUCKET_COUNT} buckets and metadata exports in ${LATEST_BACKUP}"
